PORT=3000

# Database used for sessions, OAuth tokens, and the vector document index.
# Supported values: postgres
DB_PROVIDER=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hr_chat_assistant
DB_TABLE_NAME=app_kv_records

# Zoho OAuth login. Add this callback URL in the Zoho API Console:
# http://localhost:3000/api/auth/zoho/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:3000/api/auth/zoho/callback
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.in
ZOHO_PEOPLE_BASE_URL=https://people.zoho.in
ZOHO_COMPENSATION_BASE_URL=https://people.zoho.in
ZOHO_OAUTH_SCOPES=ZOHOPEOPLE.employee.READ,ZOHOPEOPLE.forms.READ,ZOHOPEOPLE.attendance.ALL,ZOHOPEOPLE.leave.READ,ZOHOPEOPLE.leave.CREATE,ZohoPeople.compensation.ALL,AaaServer.profile.Read

# Optional legacy fallback for server-to-server/internal calls. The browser chat uses per-user Zoho login.
ZOHO_REFRESH_TOKEN=

# Leave blank to use EmployeeID from the employee API response.
# Other supported values: zohoId, recordId, email.
ZOHO_EMPLOYEE_IDENTIFIER_FIELD=

# Leave blank to use the Zoho employee record number for salary component API calls.
# Usually this should stay blank. Set only if your Zoho compensation endpoint expects a different field.
ZOHO_SALARY_IDENTIFIER_FIELD=

# Optional local Ollama summaries for policies, leave, holidays, and user details.
# The assistant still works without Ollama by returning the formatted HR data.
ENABLE_OLLAMA_SUMMARY=true
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_MS=120000
OLLAMA_NUM_PREDICT=160
OLLAMA_INTENT_NUM_PREDICT=64

# Rebuild the local vector policy index from src/data/hrPolicies.js on next server start.
REINDEX_POLICIES=false
